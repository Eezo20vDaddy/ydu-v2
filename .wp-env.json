{
	"testsEnvironment": false,
	"phpVersion": "8.5",
	"themes": [ "./themes/ydu" ],
	"plugins": [
		"https://downloads.wordpress.org/plugin/woocommerce.11.2.1.zip",
		"https://downloads.wordpress.org/plugin/product-import-export-for-woo.2.6.8.zip",
		"https://downloads.wordpress.org/plugin/contact-form-7.6.2.4.1.zip",
		"https://downloads.wordpress.org/plugin/litespeed-cache.7.9.2.zip",
		"https://downloads.wordpress.org/plugin/honeypot.2.4.02.zip",
		"https://downloads.wordpress.org/plugin/limit-login-attempts-reloaded.3.4.0.zip",
		"https://downloads.wordpress.org/plugin/google-listings-and-ads.3.10.0.zip",
		"https://downloads.wordpress.org/plugin/facebook-for-woocommerce.3.7.8.zip",
		"https://downloads.wordpress.org/plugin/woocommerce-paypal-payments.4.2.0.zip",
		"https://downloads.wordpress.org/plugin/woocommerce-services.3.7.4.zip",
		"https://downloads.wordpress.org/plugin/theme-my-login.7.3.1.zip",
		"https://downloads.wordpress.org/plugin/woocommerce-payments.11.2.0.zip",
		"./plugins/ydu-fitment",
		"./plugins/ydu-trade"
	],
	"mappings": {
		"wp-content/ydu-seed/data": "./data",
		"wp-content/ydu-seed/tools": "./tools"
	},
	"config": {
		"WP_MEMORY_LIMIT": "512M",
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": false,
		"SCRIPT_DEBUG": true
	}
